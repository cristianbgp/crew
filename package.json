{
  "name": "@cristianbgp/crew",
  "version": "0.2.0",
  "type": "module",
  "description": "Your services, one workspace.",
  "bin": {
    "crew": "./bin/crew.cjs"
  },
  "scripts": {
    "dev": "bun --no-env-file src/entry.ts dev",
    "demo": "bun --no-env-file src/entry.ts demo",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun test",
    "test:terminal": "bun tests/terminal-smoke.ts",
    "format": "oxfmt --write .",
    "lint": "oxlint --deny-warnings src tests scripts bin",
    "lint:fix": "oxlint --fix --deny-warnings src tests scripts bin",
    "format:check": "oxfmt --check .",
    "test:soak": "bun tests/soak.tsx",
    "install:local": "bun --no-env-file scripts/link-local.ts",
    "build": "bun --no-env-file scripts/build.ts",
    "test:standalone": "bun --no-env-file tests/standalone.ts",
    "package": "bun --no-env-file scripts/package.ts",
    "test:npm": "bun --no-env-file tests/npm-install.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/react": "^19.3.0",
    "@xterm/headless": "^6.0.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "typescript": "^7.0.2",
    "@opentui/core": "^0.6.6",
    "@opentui/react": "^0.6.6",
    "react": "^19.3.1",
    "toml-eslint-parser": "^1.0.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cristianbgp/crew.git"
  },
  "homepage": "https://github.com/cristianbgp/crew#readme",
  "bugs": {
    "url": "https://github.com/cristianbgp/crew/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "cli",
    "tui",
    "development",
    "monorepo",
    "process-manager"
  ],
  "files": [
    "bin/crew.cjs",
    "LICENSE",
    "README.md",
    "docs/configuration.md",
    "docs/distribution.md",
    "docs/verification.md",
    "docs/images/screenshot.png"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
